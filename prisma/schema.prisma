generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model NewsArticle {
  id            Int      @id @default(autoincrement())
  url           String   @unique
  title         String
  content       String
  rawHtml       String?
  source        String
  publishedAt   DateTime
  summary       String?
  sentiment     String?
  keyDataPoints String?
  aiProcessed   Boolean  @default(false)
  createdAt     DateTime @default(now())

  instruments ArticleInstrument[]
}

model TradingInstrument {
  id       Int    @id @default(autoincrement())
  symbol   String @unique
  name     String
  type     String
  exchange String?

  articles ArticleInstrument[]
}

model ArticleInstrument {
  id           Int   @id @default(autoincrement())
  articleId    Int
  instrumentId Int
  relevance    Float @default(1.0)

  article    NewsArticle       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  instrument TradingInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([articleId, instrumentId])
}

model ScrapeJob {
  id      Int      @id @default(autoincrement())
  source  String   @unique
  status  String   @default("idle")
  lastRun DateTime?
  count   Int      @default(0)
  error   String?
}

model FuturesVarietyAnalysis {
  id           Int      @id @default(autoincrement())
  variety      String   @unique
  contradiction String
  opportunity  String
  bullCase     String
  bearCase     String
  sentiment    String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
